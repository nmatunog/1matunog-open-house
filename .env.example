# Copy this file to .env.local
# Values come from Firebase console → Project settings → Your apps (Web).
# Do not paste these values into pull request text, chat logs, or screenshots.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cma-dashboard-01.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cma-dashboard-01
VITE_FIREBASE_STORAGE_BUCKET=cma-dashboard-01.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" only when talking to local emulators. Leave unset for the real project.
# VITE_USE_EMULATORS=true
